# Copy to services/api/.env. Everything is optional: without a key the tutor and photo
# recognition are switched off and the rest of the studio works unchanged.

# Grounded tutor and structure recognition from photos.
ANTHROPIC_API_KEY=
# Only needed if your API key is scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Models (defaults shown).
# ORBITAL_TUTOR_MODEL=claude-opus-5
# ORBITAL_TUTOR_MODEL_LARGE=claude-opus-5

# STOUT V2 service for ML name candidates (always round-trip verified before display).
# STOUT_URL=

# MolScribe checkpoint for on-server photo recognition (otherwise the vision model is used).
# MOLSCRIBE_CHECKPOINT=
