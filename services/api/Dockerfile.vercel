# Orbital chemistry API as a Vercel container function (vercel.json → services.api).
# RDKit, PySCF and a JVM for OPSIN don't fit a plain Python function, so this image carries them.
# Stateless: everything durable goes to Redis (app/store.py) because instances scale to zero.

FROM eclipse-temurin:21-jdk AS opsin
WORKDIR /opsin
ADD https://github.com/dan2097/opsin/releases/download/2.9.0/opsin-core-2.9.0-jar-with-dependencies.jar ./
COPY opsin/OpsinBridge.java ./
RUN mkdir classes && javac -cp opsin-core-2.9.0-jar-with-dependencies.jar -d classes OpsinBridge.java

FROM python:3.12-slim
# RDKit's drawing code links against these X libraries even when rendering off-screen.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libxrender1 libxext6 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=eclipse-temurin:21-jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    ORBITAL_DATA_DIR=/tmp/orbital \
    OPSIN_DIR=/app/opsin \
    OMP_NUM_THREADS=1 \
    ORBITAL_QUANTUM_MAX_NAO_HF=260 \
    ORBITAL_QUANTUM_MAX_NAO_B3LYP=235

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY --from=opsin /opsin/opsin-core-2.9.0-jar-with-dependencies.jar /app/opsin/
COPY --from=opsin /opsin/classes /app/opsin/classes
COPY app ./app

# Vercel sends traffic to $PORT (80 unless the project overrides it).
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80} --proxy-headers --forwarded-allow-ips='*'"]
